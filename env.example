# Resend API Key za slanje emailova (pravi ključ ide samo u Vercel env vars / .env.local)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Email adresa na koju dolaze upiti iz kontakt forme
CONTACT_TO_EMAIL=booking@djdomza-eventi.hr

# URL stranice (koristi se za metadata i sitemap)
NEXT_PUBLIC_SITE_URL=https://djdomza-eventi.hr

# Google Tag Manager container ID (GTM-XXXXXXX). Ako nije postavljen, GTM se ne učitava.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
